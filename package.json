{
  "name": "onevessel-ui",
  "version": "3.4.0",
  "description": "Identidade compartilhada dos apps OneVessel: tokens, CSS de componentes, fontes e ícones de PWA.",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./css/tokens.css": "./css/tokens.css",
    "./css/fontes.css": "./css/fontes.css",
    "./css/onevessel.css": "./css/onevessel.css",
    "./css/casca.css": "./css/casca.css",
    "./css/impressao.css": "./css/impressao.css",
    "./js/paleta-nucleo.js": {
      "types": "./js/paleta-nucleo.d.ts",
      "default": "./js/paleta-nucleo.js"
    },
    "./js/foco-preso.js": {
      "types": "./js/foco-preso.d.ts",
      "default": "./js/foco-preso.js"
    },
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./tailwind/preset.js": "./tailwind/preset.js",
    "./icons/*": "./icons/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "css",
    "fonts",
    "icons",
    "js",
    "manifestos",
    "tokens",
    "tailwind"
  ],
  "scripts": {
    "build": "node scripts/gerar-tokens.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "conferir": "node scripts/conferir.mjs",
    "testar": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
