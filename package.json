{
  "name": "onevessel-ui",
  "version": "3.18.2",
  "description": "Identidade compartilhada dos apps OneVessel: tokens, CSS de componentes, fontes, ícones de PWA e o logo dos relatórios.",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./css/tokens.css": "./css/tokens.css",
    "./css/fontes.css": "./css/fontes.css",
    "./css/onevessel.css": "./css/onevessel.css",
    "./css/casca.css": "./css/casca.css",
    "./css/janelas.css": "./css/janelas.css",
    "./css/telas.css": "./css/telas.css",
    "./css/relatorio.css": "./css/relatorio.css",
    "./css/impressao.css": "./css/impressao.css",
    "./css/previa.css": "./css/previa.css",
    "./css/controles.css": "./css/controles.css",
    "./js/paleta-nucleo.js": {
      "types": "./js/paleta-nucleo.d.ts",
      "default": "./js/paleta-nucleo.js"
    },
    "./js/foco-preso.js": {
      "types": "./js/foco-preso.d.ts",
      "default": "./js/foco-preso.js"
    },
    "./js/toast-nucleo.js": {
      "types": "./js/toast-nucleo.d.ts",
      "default": "./js/toast-nucleo.js"
    },
    "./js/teclas-do-painel.js": {
      "types": "./js/teclas-do-painel.d.ts",
      "default": "./js/teclas-do-painel.js"
    },
    "./js/camada.js": {
      "types": "./js/camada.d.ts",
      "default": "./js/camada.js"
    },
    "./js/alteracoes-nucleo.js": {
      "types": "./js/alteracoes-nucleo.d.ts",
      "default": "./js/alteracoes-nucleo.js"
    },
    "./js/teclas-da-tabela.js": {
      "types": "./js/teclas-da-tabela.d.ts",
      "default": "./js/teclas-da-tabela.js"
    },
    "./js/lateral-nucleo.js": {
      "types": "./js/lateral-nucleo.d.ts",
      "default": "./js/lateral-nucleo.js"
    },
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./tailwind/preset.js": "./tailwind/preset.js",
    "./icons/*": "./icons/*",
    "./fonts/*": "./fonts/*",
    "./marca/*": "./marca/*"
  },
  "files": [
    "css",
    "fonts",
    "icons",
    "js",
    "manifestos",
    "marca",
    "tokens",
    "tailwind"
  ],
  "scripts": {
    "build": "node scripts/gerar-tokens.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "conferir": "node scripts/conferir.mjs",
    "testar": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
